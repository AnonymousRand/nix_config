input {
    keyboard {
        // use default keyboard layout etc. provided by host's nix config
        xkb {
            layout "us"
            // the x11 compose key for typing alt characters like em dashes
            options "compose:rctrl"
        }
        // enable numlock on startup
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // turn off dynamic mouse acceleration
        accel-profile "flat"
        scroll-method "two-finger"
    }

    mouse {
        accel-profile "flat"
    }
}
