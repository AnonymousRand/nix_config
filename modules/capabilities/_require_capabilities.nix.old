{ den, ... }: {
  den.aspects.capabilities.require-capabilities = { config, lib, ... }:
    let 
      areRequiredCapabilitiesMet = host:
        builtins.foldl' (acc: new: acc && host.capabilities.${new}.supported)
        true (config.requiredCapabilities or []);
    in
    {
      imports = [
        {
          options = {
            requiredCapabilities = lib.mkOption {
              type = lib.types.listOf lib.types.str;
              default = [];
            };

            rawHomeManager = lib.mkOption {
              type = lib.types.deferredModule;
              default = {};
            };
          };
        }
      ];

      homeManager = { host, pkgs, ... }:
        if (areRequiredCapabilitiesMet host) then
          config.rawHomeManager
          #{ imports = [ config.rawHomeManager ]; }
        else
          {};
    };
}
